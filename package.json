    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.14.0",
    "next": "15.5.18",
    "next-auth": "5.0.0-beta.31",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.12.3",
    "shadcn": "^4.7.0",
