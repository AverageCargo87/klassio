[Unit]
Description=Klassio Sber-tutor voice orchestrator (SaluteSpeech + GigaChat, /tutor-ru)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/klassio-sber-tutor
EnvironmentFile=/opt/klassio-sber-tutor/.env
ExecStart=/usr/bin/node /opt/klassio-sber-tutor/index.mjs

# Auto-restart on crash, with backoff to avoid tight loops.
Restart=always
RestartSec=5s

# Holds per-session GigaChat histories + audio buffers — a bit roomier than the proxy.
MemoryMax=768M
TasksMax=200

# Log to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=klassio-sber-tutor

[Install]
WantedBy=multi-user.target
