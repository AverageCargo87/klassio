# Klassio Phase 1 environment template
# Copy this to .env.local and fill in real values. .env.local is gitignored.
# See README.md (Phase 2) and .planning/phases/01-account-shell/01-RESEARCH.md for full setup.

# === Database (Supabase) ===
# Two URLs needed (RESEARCH Pitfall 3):
# - DATABASE_URL: transaction pooler (port 6543) — used by app at runtime. Set ?prepare=false in client config.
# - DATABASE_URL_DIRECT: direct connection (port 5432) — used by drizzle-kit migrations and scripts/seed.ts.
# Get both from Supabase Dashboard → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# === NextAuth ===
# Generate with: npx auth secret
# Must be at least 32 characters. NEVER commit the real value.
AUTH_SECRET=

# === Resend (email magic link) ===
# Get from: https://resend.com → API Keys → Create API Key (Full Access)
# Free tier: 3000 emails/month, 100/day — sufficient for Phase 1.
AUTH_RESEND_KEY=re_your_key_here

# === Optional ===
# Override callback URL in dev. In production, Vercel sets VERCEL_URL automatically.
# AUTH_URL=http://localhost:3000

# Seed script target (used by `npm run db:seed`).
SEED_ADMIN_EMAIL=kratov.gr@gmail.com

# === Board AI (Phase 4) ===
# OpenAI API key for board /api/draw endpoint
# (CON-openai-rf-block — Vercel hits with US IP, dev needs HTTPS_PROXY tunnel)
# Get from: https://platform.openai.com → API Keys
OPENAI_API_KEY=

# Dev only (RU VPN proxy mode) — leave empty in production
# Vercel production: DO NOT set HTTPS_PROXY — instrumentation.ts auto-detects and skips
# HTTPS_PROXY=http://127.0.0.1:10801

# === 11labs Conversational AI (Phase 6) ===
# Klassio voice tutor agent on ElevenLabs Conversational AI.
# Setup details: .planning/PHASE-6-SETUP-2026-05-10.md
#
# Both vars are SERVER-ONLY (no NEXT_PUBLIC_ prefix). Client never reads them
# directly — it calls /api/voice/signed-url which generates a signed WebSocket
# URL with Agent ID baked into the signature. With Authentication=ON on the
# 11labs agent, this is the only valid connection path.
#
# Server-side API key — calls elevenlabs.io REST API for getSignedUrl.
# Permissions: ElevenAgents=Write, Voices=Read, History=Read.
# Get from: https://elevenlabs.io/app/settings/api-keys → Create API Key.
ELEVENLABS_API_KEY=sk_your_key_here

# Server-side agent identifier — used by /api/voice/signed-url route only.
# Get from agent URL: https://elevenlabs.io/app/agents/agents/agent_XXXXX → copy `agent_XXXXX` part.
ELEVENLABS_AGENT_ID=agent_your_agent_id

# === AI-репетитор agent (June 2026 pivot) ===
# Separate agent for the AI-tutor (okr-mir-4) — new role/prompt/tools, distinct
# from the math agent above. Used by /api/tutor/signed-url. Provision it with
# scripts/restore-tutor-agent.mjs (see scripts/tutor-agent-prompt.md).
# If UNSET, /api/tutor/signed-url falls back to ELEVENLABS_AGENT_ID (math agent)
# with a warning — plumbing works for testing, but the voice behaves as the
# math teacher until this is set.
ELEVENLABS_TUTOR_AGENT_ID=
